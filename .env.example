# Copiá este archivo como .env y completá los valores.

# ── Entorno ─────────────────────────────────────────────────
# En el servidor publicado (Render) poné NODE_ENV=production: oculta los
# usuarios de prueba del login y desactiva los modos demo (Google y pagos).
# En tu computadora dejalo vacío.
NODE_ENV=

# ── Inicio de sesión con Google (opcional) ──────────────────
# Si están vacíos, "Continuar con Google" funciona en modo demo.
# Se crean en https://console.cloud.google.com → APIs y servicios →
# Credenciales → ID de cliente de OAuth (aplicación web).
# En "URI de redireccionamiento autorizados" agregá GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── Sesión ──────────────────────────────────────────────────
# Clave para firmar la cookie de sesión. En producción: una frase larga y secreta.
SESSION_SECRET=

# ── Base de datos MySQL ─────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tienda_db
# true para ver en consola las consultas SQL
DB_LOG=false
# Zona horaria de las fechas (Argentina)
DB_TIMEZONE=-03:00
# Máximo de conexiones a la vez (Clever Cloud gratis: 5 en total, usá 3)
DB_POOL_MAX=5

# ── Dirección pública de la tienda ──────────────────────────
# Con https, Mercado Pago vuelve solo a la tienda después de pagar
# y avisa cada pago por webhook (APP_URL/pagos/webhook).
APP_URL=http://localhost:3000

# ── Pagos con Mercado Pago (tarjetas de crédito y débito) ───
# Si MP_ACCESS_TOKEN está vacío, los pagos funcionan en MODO DEMO
# (se simulan y no se cobra nada).
# Las credenciales se sacan en https://www.mercadopago.com.ar/developers/panel/app
# → Tu aplicación → Credenciales de producción (o de prueba, empiezan con TEST-).
# NUNCA subas este valor al repositorio ni lo compartas.
MP_ACCESS_TOKEN=
# Clave secreta de las notificaciones (Tu aplicación → Webhooks). Opcional:
# si está, se verifica la firma de cada aviso de Mercado Pago.
MP_WEBHOOK_SECRET=
# Nombre que se ve en Mercado Pago y en el resumen de la tarjeta (máx. 22 letras)
MP_NOMBRE_TIENDA=Tienda
MP_RESUMEN_TARJETA=
# Máximo de cuotas que se ofrecen
MP_MAX_CUOTAS=6
# Horas que se reserva un pedido con tarjeta sin pagar (después se cancela solo)
PAGO_VENCE_HORAS=48

# ── Datos para pagar por transferencia ──────────────────────
TRANSFERENCIA_ALIAS=
TRANSFERENCIA_CBU=
TRANSFERENCIA_TITULAR=
TRANSFERENCIA_BANCO=
