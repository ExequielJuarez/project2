<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  const r = resumen;
  const d = datos;
  const hayErrores = Object.keys(errores).length > 0;
  const esRetiro = d.entrega === "retiro";
  const esFacturaA = d.facturacion === "facturaA";
%>

  <!-- ═════════════ ENCABEZADO ═════════════ -->
  <section class="checkout-hero contenedor">
    <nav class="migas" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href="/carrito">Carrito</a>
      <span>/</span>
      <span aria-current="page">Datos</span>
    </nav>

    <div class="checkout-hero__fila">
      <h1 class="checkout-hero__titulo">Tus datos</h1>
      <%- include('partials/pasos', { pasoActual: 2 }) %>
    </div>
  </section>

  <!-- ═════════════ CHECKOUT ═════════════ -->
  <main class="checkout contenedor">

    <%- include('partials/resumen-pedido', { r: resumen, editarPago: '/carrito' }) %>

    <!-- Formulario -->
    <form class="checkout-form" id="formDatos" action="/checkout/datos" method="POST" novalidate>

      <% if (hayErrores) { %>
        <div class="aviso aviso--error" role="alert" id="resumenErrores" tabindex="-1">
          <strong>Revisá estos datos:</strong>
          <ul>
            <% Object.entries(errores).forEach(([campo, e]) => { %>
              <li><a href="#<%= campo %>"><%= e.msg %></a></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <!-- 01 Contacto -->
      <fieldset class="bloque">
        <legend class="bloque__titulo"><span>01</span> Contacto</legend>

        <div class="campos">
          <%- include('partials/campo', { nombre: 'email', etiqueta: 'Email', tipo: 'email', placeholder: 'tu@email.com', clase: 'campo--completo', attrs: 'autocomplete="email" required' }) %>
          <%- include('partials/campo', { nombre: 'nombre', etiqueta: 'Nombre', attrs: 'autocomplete="given-name" required' }) %>
          <%- include('partials/campo', { nombre: 'apellido', etiqueta: 'Apellido', attrs: 'autocomplete="family-name" required' }) %>
          <%- include('partials/campo', { nombre: 'telefono', etiqueta: 'Teléfono', tipo: 'tel', placeholder: '11 1234 5678', attrs: 'autocomplete="tel" inputmode="tel" required' }) %>
          <%- include('partials/campo', { nombre: 'dni', etiqueta: 'DNI', placeholder: 'Sin puntos', attrs: 'inputmode="numeric" required' }) %>
        </div>

        <label class="check-simple">
          <input type="checkbox" name="newsletter" value="1" <%= d.newsletter ? 'checked' : '' %>>
          <span class="check-simple__caja"></span>
          Quiero recibir novedades y descuentos por email
        </label>
      </fieldset>

      <!-- 02 Entrega -->
      <fieldset class="bloque">
        <legend class="bloque__titulo"><span>02</span> Entrega</legend>

        <div class="opciones">
          <label class="opcion-card">
            <input type="radio" name="entrega" value="domicilio" <%= !esRetiro ? 'checked' : '' %>>
            <span class="opcion-card__caja">
              <svg viewBox="0 0 24 24" width="22" height="22"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.7" fill="var(--blanco)" stroke="currentColor" stroke-width="1.5"/><circle cx="17" cy="17.5" r="1.7" fill="var(--blanco)" stroke="currentColor" stroke-width="1.5"/></svg>
              <span class="opcion-card__texto">
                <strong>Envío a domicilio</strong>
                <small>3 a 5 días hábiles</small>
              </span>
              <span class="opcion-card__precio"><%= r.envioGratis ? 'Gratis' : formatoPrecio(r.costoEnvio) %></span>
            </span>
          </label>
          <label class="opcion-card">
            <input type="radio" name="entrega" value="retiro" <%= esRetiro ? 'checked' : '' %>>
            <span class="opcion-card__caja">
              <svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 10l1.5-5h13L20 10M4 10v10h16V10M4 10h16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 20v-5h4v5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              <span class="opcion-card__texto">
                <strong>Retiro en showroom</strong>
                <small>Listo en 24 hs hábiles</small>
              </span>
              <span class="opcion-card__precio">Gratis</span>
            </span>
          </label>
        </div>
        <% if (errores.entrega) { %><p class="campo__error"><%= errores.entrega.msg %></p><% } %>

        <div class="grupo" id="grupoDomicilio" <%= esRetiro ? 'hidden' : '' %>>
          <div class="campos">
            <%- include('partials/campo', { nombre: 'calle', etiqueta: 'Calle', clase: 'campo--ancho', attrs: 'autocomplete="address-line1"' }) %>
            <%- include('partials/campo', { nombre: 'numero', etiqueta: 'Altura', placeholder: '1234 o S/N', clase: 'campo--angosto' }) %>
            <%- include('partials/campo', { nombre: 'piso', etiqueta: 'Piso / Depto', opcional: true, placeholder: 'Ej: 3° B', attrs: 'autocomplete="address-line2"' }) %>
            <%- include('partials/campo', { nombre: 'codigoPostal', etiqueta: 'Código postal', placeholder: '1405', attrs: 'inputmode="numeric" maxlength="4" autocomplete="postal-code"' }) %>
            <%- include('partials/campo', { nombre: 'ciudad', etiqueta: 'Ciudad / Localidad', attrs: 'autocomplete="address-level2"' }) %>
            <%- include('partials/campo', { nombre: 'provincia', etiqueta: 'Provincia', tipo: 'select', opciones: provincias }) %>
            <%- include('partials/campo', { nombre: 'notas', etiqueta: 'Indicaciones para la entrega', tipo: 'textarea', opcional: true, clase: 'campo--completo', placeholder: 'Ej: timbre que no funciona, horario, entre calles…', attrs: 'maxlength="300"' }) %>
          </div>
        </div>

        <div class="retiro" id="grupoRetiro" <%= esRetiro ? '' : 'hidden' %>>
          <p class="retiro__titulo">(DIRECCIÓN DEL SHOWROOM)</p>
          <p>(Barrio, Ciudad) · Lunes a viernes de 10 a 18 hs · Sábados de 10 a 14 hs</p>
          <p>Te avisamos por email cuando tu pedido esté listo para retirar.</p>
        </div>
      </fieldset>

      <!-- 03 Facturación -->
      <fieldset class="bloque">
        <legend class="bloque__titulo"><span>03</span> Facturación</legend>

        <div class="segmentos" role="radiogroup" aria-label="Tipo de factura">
          <label class="segmento">
            <input type="radio" name="facturacion" value="consumidor" <%= !esFacturaA ? 'checked' : '' %>>
            <span>Consumidor final</span>
          </label>
          <label class="segmento">
            <input type="radio" name="facturacion" value="facturaA" <%= esFacturaA ? 'checked' : '' %>>
            <span>Factura A</span>
          </label>
        </div>

        <div class="grupo" id="grupoFacturaA" <%= esFacturaA ? '' : 'hidden' %>>
          <div class="campos">
            <%- include('partials/campo', { nombre: 'cuit', etiqueta: 'CUIT', placeholder: '20-12345678-9', attrs: 'inputmode="numeric" maxlength="13"' }) %>
            <%- include('partials/campo', { nombre: 'razonSocial', etiqueta: 'Razón social', attrs: 'autocomplete="organization"' }) %>
          </div>
        </div>
      </fieldset>

      <!-- Acciones -->
      <div class="checkout-acciones">
        <a href="/carrito" class="checkout-acciones__volver">← Volver al carrito</a>
        <button type="submit" class="btn btn--solido checkout-acciones__continuar" id="btnContinuar">
          Continuar al pago
        </button>
      </div>

      <p class="checkout-legal">
        Tus datos se usan solo para procesar tu pedido. (LINK A POLÍTICA DE PRIVACIDAD)
      </p>
    </form>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/checkout-datos.js"></script>
</body>
</html>
