<%- include('../partials/admin-inicio') %>

<%
  const url = (extra) => {
    const q = new URLSearchParams({ ...filtros, ...extra });
    [...q.keys()].forEach(k => !q.get(k) && q.delete(k));
    const s = q.toString();
    return '/admin/pedidos' + (s ? '?' + s : '');
  };
  const nombresEstado = { pendiente: 'Pendiente', pagado: 'Pagado', enviado: 'Enviado', entregado: 'Entregado', cancelado: 'Cancelado', sin_pagar: 'Sin pagar' };
  // Transferencia esperando que el admin confirme que se acreditó
  const esperaTransferencia = (p) => p.medioPago === 'transferencia' && p.estado === 'pendiente' && p.pagoEstado !== 'aprobado';
  const nombresPago = { pendiente: 'pago pendiente', aprobado: 'pago aprobado', rechazado: 'pago rechazado', reembolsado: 'reembolsado' };
%>

      <div class="admin-cabecera">
        <div>
          <p class="admin-cabecera__migas"><a href="/admin">Panel</a> / Pedidos</p>
          <h1 class="admin-cabecera__titulo">Pedidos</h1>
          <p class="admin-cabecera__bajada"><%= total %> en total · <span data-pendientes><%= pedidosPendientes %></span> por preparar o enviar</p>
        </div>
      </div>

      <nav class="segmentado segmentado--estados" aria-label="Filtrar por estado">
        <a href="<%= url({ estado: '' }) %>" class="<%= !filtros.estado ? 'activo' : '' %>">Todos <small><%= total %></small></a>
        <% estados.forEach(e => { %>
          <a href="<%= url({ estado: e }) %>" class="<%= filtros.estado === e ? 'activo' : '' %>"><%= nombresEstado[e] %> <small data-conteo="<%= e %>"><%= conteo[e] %></small></a>
        <% }) %>
        <a href="<%= url({ estado: 'sin_pagar' }) %>" class="segmentado__aparte <%= filtros.estado === 'sin_pagar' ? 'activo' : '' %>" title="Compras con tarjeta que el cliente no terminó de pagar">Sin pagar <small data-conteo="sin_pagar"><%= conteo.sin_pagar %></small></a>
      </nav>

      <% if (filtros.estado === 'sin_pagar') { %>
        <p class="aviso-pedidos">
          Compras con tarjeta que el cliente <strong>no terminó de pagar</strong> en Mercado Pago. No tenés que hacer nada:
          si las paga pasan solas a <strong>Pagado</strong>, y si no, se cancelan solas y el stock vuelve.
        </p>
      <% } else if (filtros.estado === 'pendiente') { %>
        <p class="aviso-pedidos">
          Pedidos que esperan tu confirmación: <strong>transferencias</strong> que tenés que verificar en tu cuenta.
          Cuando se acredite, tocá <strong>Confirmar transferencia</strong> y el cliente lo ve como pagado.
        </p>
      <% } %>

      <form class="filtros-admin" action="/admin/pedidos" method="GET" role="search" id="filtrosPedidos">
        <% if (filtros.estado) { %><input type="hidden" name="estado" value="<%= filtros.estado %>"><% } %>
        <label class="filtros-admin__buscar">
          <svg viewBox="0 0 24 24" width="16" height="16"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <input class="campo__control" type="search" name="q" value="<%= filtros.q %>" placeholder="Buscar por número o cliente" aria-label="Buscar pedido">
        </label>
      </form>

      <% if (!lista.length) { %>
        <div class="admin-vacio">
          <strong>No hay pedidos</strong>
          Probá con otro estado o búsqueda.
        </div>
      <% } else { %>
        <ul class="pedidos-lista">
          <% lista.forEach(p => { %>
            <li class="pedido-fila" data-numero="<%= p.numero %>" data-unidades="<%= p.items.filter(i => i.productoId).reduce((a, i) => a + i.cantidad, 0) %>" data-ganancia="<%= p.ganancia %>">
              <details>
                <summary class="pedido-fila__resumen">
                  <span class="pedido-fila__numero">#<%= p.numero %></span>
                  <span class="pedido-fila__cliente">
                    <strong><%= p.cliente %></strong>
                    <small><%= formatoFecha(p.fecha, true) %> · <%= p.items.reduce((a, i) => a + i.cantidad, 0) %> u. · <%= p.medioPago %> <span class="cobro cobro--<%= p.pagoEstado %>" data-cobro><%= nombresPago[p.pagoEstado] %></span> · <%= p.entrega === 'retiro' ? 'retiro' : 'envío' %></small>
                  </span>
                  <span class="pedido-fila__estado estado estado--<%= p.estado %>" data-estado-tag><%= esperaTransferencia(p) ? 'Verificar pago' : nombresEstado[p.estado] %></span>
                  <span class="pedido-fila__total">
                    <strong><%= formatoPrecio(p.total) %></strong>
                    <small data-ganancia-texto><%= p.estado === 'cancelado' ? 'cancelado · no suma' : 'ganancia ' + formatoCompacto(p.ganancia) %></small>
                  </span>
                  <span class="pedido-fila__flecha" aria-hidden="true"></span>
                </summary>

                <div class="pedido-fila__detalle">
                  <div class="pedido-fila__datos">
                    <div>
                      <p class="pedido-fila__dato-titulo">Cliente</p>
                      <p><%= p.email %><%= p.telefono ? ` · ${p.telefono}` : '' %><%= p.dni ? ` · DNI ${p.dni}` : '' %></p>
                      <p><%= p.facturacion === 'facturaA' ? `Factura A · ${p.razonSocial} · ${p.cuit}` : 'Consumidor final' %></p>
                    </div>
                    <div>
                      <p class="pedido-fila__dato-titulo"><%= p.entrega === 'retiro' ? 'Retira en el showroom' : 'Envío a' %></p>
                      <% if (p.entrega !== 'retiro') { %>
                        <p><%= p.calle %> <%= p.altura %><%= p.piso ? `, ${p.piso}` : '' %> · <%= p.ciudad %>, <%= p.provincia %> (<%= p.codigoPostal %>)</p>
                      <% } %>
                      <% if (p.notas) { %><p><em>“<%= p.notas %>”</em></p><% } %>
                    </div>
                    <div>
                      <p class="pedido-fila__dato-titulo">Cobro · <span data-cobro-texto><%= nombresPago[p.pagoEstado] %></span></p>
                      <p><%= p.medioPago === 'transferencia' ? 'Transferencia' : 'Tarjeta (Mercado Pago)' %><%= p.pagoDetalle ? ` · ${p.pagoDetalle}` : '' %></p>
                      <% if (p.pagoId && !String(p.pagoId).startsWith('demo')) { %><p><small>Id del pago en Mercado Pago: <%= p.pagoId %></small></p><% } %>
                    </div>
                  </div>

                  <table class="tabla">
                    <thead><tr><th>Producto</th><th class="num">Cant.</th><th class="num">Precio</th><th class="num">Subtotal</th></tr></thead>
                    <tbody>
                      <% p.items.forEach(i => { %>
                        <tr>
                          <td><%= i.nombre %><% if (i.color) { %> <small>· <%= i.color %><%= i.talle ? ' · ' + i.talle : '' %></small><% } %></td>
                          <td class="num"><%= i.cantidad %></td>
                          <td class="num"><%= formatoPrecio(i.precio) %></td>
                          <td class="num"><%= formatoPrecio(i.precio * i.cantidad) %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>

                  <div class="pedido-fila__pie">
                    <dl class="pedido-fila__totales">
                      <div><dt>Subtotal</dt><dd><%= formatoPrecio(p.subtotal) %></dd></div>
                      <% if (p.descuento) { %><div><dt>Descuentos</dt><dd>-<%= formatoPrecio(p.descuento) %></dd></div><% } %>
                      <div><dt>Envío</dt><dd><%= p.envio ? formatoPrecio(p.envio) : 'Gratis' %></dd></div>
                      <div><dt>Costo mercadería</dt><dd>-<%= formatoPrecio(p.costo) %></dd></div>
                      <div class="pedido-fila__ganancia"><dt>Ganancia</dt><dd><%= formatoPrecio(p.ganancia) %></dd></div>
                    </dl>

                    <% if (esperaTransferencia(p)) { %>
                      <button type="button" class="btn btn--solido btn--chico pedido-fila__confirmar" data-confirmar-transferencia
                              data-total="<%= formatoPrecio(p.total) %>">Confirmar transferencia</button>
                    <% } %>
                    <label class="pedido-fila__cambiar">
                      <span>Cambiar estado</span>
                      <select class="campo__control" data-cambiar-estado>
                        <% estados.forEach(e => { %>
                          <option value="<%= e %>" <%= p.estado === e ? 'selected' : '' %>><%= nombresEstado[e] %></option>
                        <% }) %>
                      </select>
                    </label>
                  </div>
                </div>
              </details>
            </li>
          <% }) %>
        </ul>
      <% } %>

<%- include('../partials/admin-fin') %>
<script src="/js/admin-pedidos.js"></script>
</body>
</html>
