<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  const r = resumen;
  const d = datos;
  const esRetiro = d.entrega === "retiro";
  const conTarjeta = r.medioPago !== "transferencia";
%>

  <!-- ═════════════ ENCABEZADO ═════════════ -->
  <section class="checkout-hero contenedor">
    <nav class="migas" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href="/carrito">Carrito</a>
      <span>/</span>
      <a href="/checkout/datos">Datos</a>
      <span>/</span>
      <span aria-current="page">Pago</span>
    </nav>

    <div class="checkout-hero__fila">
      <h1 class="checkout-hero__titulo">Pago</h1>
      <%- include('partials/pasos', { pasoActual: 3 }) %>
    </div>
  </section>

  <!-- ═════════════ CHECKOUT ═════════════ -->
  <main class="checkout contenedor">

    <%- include('partials/resumen-pedido', { r: resumen, editarPago: null }) %>

    <form class="checkout-form" id="formPago" action="/checkout/confirmar" method="POST">

      <% if (modoPago === "demo") { %>
        <div class="aviso-modo" role="note">
          <strong>Modo demostración</strong>
          Todavía no está conectado Mercado Pago: el pago se simula y no se cobra nada.
        </div>
      <% } else if (pagoDePrueba) { %>
        <div class="aviso-modo" role="note">
          <strong>Credenciales de prueba</strong>
          Mercado Pago está en modo prueba: usá sus tarjetas de prueba, no se cobra de verdad.
        </div>
      <% } %>

      <!-- Resumen de los datos cargados -->
      <section class="bloque">
        <h2 class="bloque__titulo"><span>01</span> Tus datos</h2>
        <div class="datos-resumen">
          <div class="datos-resumen__fila">
            <span class="datos-resumen__etiqueta">Contacto</span>
            <p><%= d.nombre %> <%= d.apellido %><br><%= d.email %> · <%= d.telefono %></p>
            <a href="/checkout/datos" class="datos-resumen__editar">Editar</a>
          </div>
          <div class="datos-resumen__fila">
            <span class="datos-resumen__etiqueta"><%= esRetiro ? 'Retiro' : 'Envío' %></span>
            <p>
              <% if (esRetiro) { %>
                Retirás en el showroom · (DIRECCIÓN DEL SHOWROOM)
              <% } else { %>
                <%= d.calle %> <%= d.numero %><%= d.piso ? `, ${d.piso}` : '' %><br>
                <%= d.ciudad %>, <%= d.provincia %> (<%= d.codigoPostal %>)
              <% } %>
            </p>
            <a href="/checkout/datos" class="datos-resumen__editar">Editar</a>
          </div>
        </div>
      </section>

      <!-- Medio de pago -->
      <fieldset class="bloque">
        <legend class="bloque__titulo"><span>02</span> ¿Cómo querés pagar?</legend>

        <div class="medios">
          <% if (modoPago !== "desactivado") { %>
          <label class="medio">
            <input type="radio" name="medio" value="tarjeta" <%= conTarjeta ? 'checked' : '' %>>
            <span class="medio__caja">
              <span class="medio__cabeza">
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3 10h18M7 15h4" stroke="currentColor" stroke-width="1.5"/></svg>
                <span class="medio__texto">
                  <strong>Tarjeta de crédito o débito</strong>
                  <small>Hasta <%= r.cuotas %> cuotas sin interés · pagás en Mercado Pago</small>
                </span>
              </span>
              <span class="medio__marcas" aria-label="Tarjetas aceptadas">
                <span>Visa</span><span>Mastercard</span><span>Amex</span><span>Naranja</span><span>Cabal</span><span>Maestro</span><span>Mercado Pago</span>
              </span>
              <span class="medio__detalle">
                Te llevamos a la página segura de Mercado Pago para terminar. Los datos de tu tarjeta los procesa
                Mercado Pago: nunca pasan por nuestra tienda.
              </span>
            </span>
          </label>

          <% } else { %>
            <p class="aviso-modo">El pago con tarjeta no está disponible en este momento. Podés pagar por transferencia.</p>
          <% } %>
          <label class="medio">
            <input type="radio" name="medio" value="transferencia" <%= !conTarjeta ? 'checked' : '' %>>
            <span class="medio__caja">
              <span class="medio__cabeza">
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 10l8-5 8 5M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                <span class="medio__texto">
                  <strong>Transferencia bancaria</strong>
                  <small>10% de descuento · desde tu banco o billetera virtual</small>
                </span>
                <span class="medio__etiqueta">-10%</span>
              </span>
              <span class="medio__detalle">
                Al confirmar te mostramos el alias y el CBU. Preparamos tu pedido cuando se acredita la transferencia.
              </span>
            </span>
          </label>
        </div>
      </fieldset>

      <!-- Acciones -->
      <div class="checkout-acciones">
        <a href="/checkout/datos" class="checkout-acciones__volver">← Volver a tus datos</a>
        <button type="submit" class="btn btn--solido checkout-acciones__continuar" id="btnPagar"
                data-texto-tarjeta="Pagar con Mercado Pago" data-texto-transferencia="Confirmar pedido">
          <span id="btnPagarTexto"><%= conTarjeta ? 'Pagar con Mercado Pago' : 'Confirmar pedido' %></span>
          · <span data-valor="total"><%= formatoPrecio(r.total) %></span>
        </button>
      </div>

      <p class="checkout-legal">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 11V8a4 4 0 018 0v3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        Compra protegida. Si pagás con tarjeta y no terminás el pago, reservamos tu pedido <%= venceHoras %> hs
        para que lo pagues más tarde desde la página del pedido. (LINK A TÉRMINOS Y CONDICIONES)
      </p>
    </form>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/checkout-pago.js"></script>
</body>
</html>
