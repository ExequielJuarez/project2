<%- include('partials/head') %>
<%- include('partials/header') %>

  <!-- ═════════════ HERO / ENCABEZADO DE PÁGINA ═════════════ -->
  <section class="hero contenedor">
    <nav class="migas" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span>/</span>
      <% if (busqueda) { %>
        <a href="/catalogo">Catálogo</a>
        <span>/</span>
        <span aria-current="page">Búsqueda</span>
      <% } else { %>
        <span aria-current="page"><%= titulo %></span>
      <% } %>
    </nav>
    <div class="hero__fila">
      <div>
        <% if (busqueda) { %>
          <p class="hero__etiqueta">Resultados para</p>
          <h1 class="hero__titulo hero__titulo--busqueda">“<%= busqueda %>”</h1>
          <p class="hero__texto">
            <%= productos.length ? 'Estos son los productos que coinciden con tu búsqueda.' : 'No encontramos productos con esa búsqueda.' %>
            <a href="/catalogo" class="hero__limpiar">Ver todo el catálogo</a>
          </p>
        <% } else { %>
          <h1 class="hero__titulo"><%= titulo %></h1>
          <p class="hero__texto">Prendas para combinar, lucir y repetir. Elegí tu talle y recibilo en tu casa.</p>
        <% } %>
      </div>
      <p class="hero__cantidad"><span id="cantidadVisible"><%= productos.length %></span> productos</p>
    </div>
  </section>

  <!-- ═════════════ CATÁLOGO ═════════════ -->
  <main class="catalogo contenedor">

    <!-- Barra de herramientas -->
    <div class="herramientas">
      <button class="btn-filtros" id="btnFiltros" aria-controls="filtros">
        <svg viewBox="0 0 24 24" width="16" height="16"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        Filtros
        <span class="btn-filtros__badge" id="badgeFiltros" hidden>0</span>
      </button>

      <div class="chips" id="chipsActivos"></div>

      <div class="herramientas__derecha">
        <div class="vista" role="group" aria-label="Cambiar vista">
          <button class="vista__btn" data-columnas="2" aria-label="2 columnas">
            <svg viewBox="0 0 16 16" width="14" height="14"><rect x="1" y="1" width="6" height="14" fill="currentColor"/><rect x="9" y="1" width="6" height="14" fill="currentColor"/></svg>
          </button>
          <button class="vista__btn activo" data-columnas="3" aria-label="3 columnas">
            <svg viewBox="0 0 16 16" width="14" height="14"><rect x="0.5" y="1" width="4" height="14" fill="currentColor"/><rect x="6" y="1" width="4" height="14" fill="currentColor"/><rect x="11.5" y="1" width="4" height="14" fill="currentColor"/></svg>
          </button>
          <button class="vista__btn" data-columnas="4" aria-label="4 columnas">
            <svg viewBox="0 0 16 16" width="14" height="14"><rect x="0" y="1" width="3" height="14" fill="currentColor"/><rect x="4.3" y="1" width="3" height="14" fill="currentColor"/><rect x="8.6" y="1" width="3" height="14" fill="currentColor"/><rect x="13" y="1" width="3" height="14" fill="currentColor"/></svg>
          </button>
        </div>

        <label class="orden">
          <span class="orden__label">Ordenar</span>
          <select id="orden">
            <option value="destacados">Destacados</option>
            <option value="precio-asc">Precio: menor a mayor</option>
            <option value="precio-desc">Precio: mayor a menor</option>
            <option value="nombre-asc">Nombre: A – Z</option>
          </select>
        </label>
      </div>
    </div>

    <div class="catalogo__cuerpo">

      <!-- Filtros (sidebar en PC / panel lateral en celular y tablet) -->
      <aside class="filtros" id="filtros" data-panel aria-label="Filtros">
        <div class="filtros__cabecera">
          <h2>Filtrar</h2>
          <button class="icono-btn" id="btnCerrarFiltros" aria-label="Cerrar filtros">
            <svg viewBox="0 0 24 24" width="20" height="20"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
        </div>

        <div class="acordeon abierto">
          <button class="acordeon__titulo" aria-expanded="true">Categoría <span class="acordeon__icono"></span></button>
          <div class="acordeon__contenido">
            <% categorias.forEach(cat => { %>
              <label class="check">
                <input type="checkbox" name="categoria" value="<%= cat.nombre %>">
                <span class="check__caja"></span>
                <span class="check__texto"><%= cat.nombre %></span>
                <span class="check__cantidad"><%= cat.cantidad %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="acordeon abierto">
          <button class="acordeon__titulo" aria-expanded="true">Color <span class="acordeon__icono"></span></button>
          <div class="acordeon__contenido acordeon__contenido--colores">
            <% colores.forEach(color => { %>
              <label class="color" title="<%= color.nombre %>">
                <input type="checkbox" name="color" value="<%= color.valor %>">
                <span class="color__muestra" style="--muestra: <%= color.hex %>"></span>
                <span class="color__nombre"><%= color.nombre %> <small>(<%= color.cantidad %>)</small></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="acordeon abierto">
          <button class="acordeon__titulo" aria-expanded="true">Talle <span class="acordeon__icono"></span></button>
          <div class="acordeon__contenido acordeon__contenido--talles">
            <% talles.forEach(t => { %>
              <label class="talle talle--filtro">
                <input type="checkbox" name="talle" value="<%= t %>">
                <span><%= t %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="acordeon">
          <button class="acordeon__titulo" aria-expanded="false">Precio <span class="acordeon__icono"></span></button>
          <div class="acordeon__contenido">
            <div class="rango">
              <label>
                <span>Mínimo</span>
                <input type="number" id="precioMin" placeholder="$ 0" min="0" inputmode="numeric">
              </label>
              <span class="rango__guion">—</span>
              <label>
                <span>Máximo</span>
                <input type="number" id="precioMax" placeholder="$ 999.999" min="0" inputmode="numeric">
              </label>
            </div>
          </div>
        </div>

        <div class="filtros__pie">
          <button class="btn btn--linea" id="btnLimpiar">Limpiar</button>
          <button class="btn btn--solido" id="btnAplicar">Ver resultados</button>
        </div>
      </aside>

      <!-- Grilla de productos -->
      <section class="grilla" id="grilla" data-columnas="3" aria-live="polite">
        <% productos.forEach((p, i) => { %>
          <%- include('partials/tarjeta', { p, i }) %>
        <% }) %>

        <div class="vacio" id="vacio" <%= productos.length ? 'hidden' : '' %>>
          <p class="vacio__titulo">Sin resultados</p>
          <p>Probá quitando algunos filtros.</p>
          <button class="btn btn--linea" data-limpiar>Limpiar filtros</button>
        </div>
      </section>
    </div>

    <nav class="paginacion" aria-label="Paginación">
      <a href="#" class="paginacion__num activo">1</a>
      <a href="#" class="paginacion__num">2</a>
      <a href="#" class="paginacion__num">3</a>
      <a href="#" class="paginacion__sig">Siguiente →</a>
    </nav>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/catalogo.js"></script>
</body>
</html>
