    </main>
  </div>
</div>

<!-- Modal de confirmación (lo usa admin.js con data-confirmar) -->
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitulo" hidden>
  <div class="modal__caja">
    <p class="modal__titulo" id="modalTitulo">¿Confirmás?</p>
    <p class="modal__texto" id="modalTexto"></p>
    <div class="modal__acciones">
      <button type="button" class="btn btn--linea" id="modalCancelar">Cancelar</button>
      <button type="button" class="btn btn--solido" id="modalAceptar">Eliminar</button>
    </div>
  </div>
</div>

<div class="toast" id="toast" role="status"></div>

<% if (locals.flash) { %>
  <div id="flash" data-mensaje="<%= flash %>" hidden></div>
<% } %>

<script src="/js/admin.js"></script>
<%- include('notificaciones-avisos') %>
