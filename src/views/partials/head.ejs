<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> | Matilda Boutique</title>
  <meta name="description" content="Matilda Boutique: moda femenina con detalles que se notan. Remeras, abrigos, jeans y más, con envíos a todo el país.">
  <meta name="theme-color" content="#f8f4ee">
  <link rel="icon" href="/img/marca/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/img/marca/favicon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400;1,6..96,500&family=Jost:wght@300;400;500;600&family=Pinyon+Script&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/base.css">
  <%# estilo puede ser un nombre o una lista: "login" o ["acceso", "login"] %>
  <% if (esAdmin(locals.usuarioLocal)) { %>
    <link rel="stylesheet" href="/css/notificaciones.css">
  <% } %>
  <% [].concat(locals.estilo || []).forEach(hoja => { %>
    <link rel="stylesheet" href="/css/<%= hoja %>.css">
  <% }) %>
</head>
<body>
