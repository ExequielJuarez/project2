<%
  // Un campo del editor del inicio (Admin → Inicio), armado según el esquema
  // de src/data/inicioEditable.js. Se incluye a sí mismo para las listas.
  //   def: definición del campo · ruta: ["portada", "titulo"] · valor · original
  const nombre = ruta[0] + ruta.slice(1).map((p) => `[${p}]`).join("");
  const clave = ruta.join(".");
  const id = "ce-" + ruta.join("-");
  const error = errores[clave];
  const ancho = def.ancho ? `ce--${def.ancho}` : "";
%>
<% if (def.tipo === "lista") { %>
  <%
    const variable = !def.cantidad;
    const items = valor || [];
  %>
  <fieldset class="ce-lista <%= variable ? 'ce-lista--variable' : '' %>" <%- variable ? `data-lista="${nombre}" data-min="${def.min || 0}" data-max="${def.max || 10}"` : '' %>>
    <legend class="ce-lista__titulo"><%= def.etiqueta %></legend>
    <% if (def.ayuda) { %><p class="ce__ayuda"><%= def.ayuda %></p><% } %>
    <% if (error) { %><p class="campo__error ce__error"><%= error %></p><% } %>

    <div class="ce-lista__items" data-items>
      <% items.forEach((item, i) => { %>
        <div class="ce-item" data-item>
          <div class="ce-item__cabeza">
            <p class="ce-item__titulo"><%= def.item %> <span data-numero><%= i + 1 %></span></p>
            <% if (variable) { %>
              <button type="button" class="ce-item__quitar" data-quitar>Quitar</button>
            <% } %>
          </div>
          <div class="ce-grilla">
            <% Object.entries(def.campos).forEach(([k, sub]) => { %>
              <%- include('campo-inicio', { def: sub, ruta: [...ruta, i, k], valor: item[k], original: variable ? undefined : (original && original[i] ? original[i][k] : undefined), errores }) %>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (variable) { %>
      <template data-plantilla>
        <div class="ce-item" data-item>
          <div class="ce-item__cabeza">
            <p class="ce-item__titulo"><%= def.item %> <span data-numero></span></p>
            <button type="button" class="ce-item__quitar" data-quitar>Quitar</button>
          </div>
          <div class="ce-grilla">
            <% Object.entries(def.campos).forEach(([k, sub]) => { %>
              <%- include('campo-inicio', { def: sub, ruta: [...ruta, '__i__', k], valor: sub.defecto ?? '', original: undefined, errores: {} }) %>
            <% }) %>
          </div>
        </div>
      </template>
      <button type="button" class="ce-lista__agregar" data-agregar>+ Agregar <%= def.item.toLowerCase() %></button>
    <% } %>
  </fieldset>

<% } else if (def.tipo === "imagen") { %>
  <div class="ce ce--imagen <%= ancho %>" data-foto>
    <span class="campo__label"><%= def.etiqueta %></span>
    <div class="ce-foto <%= def.fondo === 'oscuro' ? 'ce-foto--oscuro' : '' %>">
      <img src="<%= valor %>" alt="" class="ce-foto__img" data-foto-img>
      <span class="ce-foto__nueva" data-foto-nueva hidden>Nueva</span>
    </div>
    <div class="ce-foto__acciones">
      <label class="btn btn--chico btn--linea ce-foto__cambiar">
        Cambiar foto
        <input type="file" name="archivo:<%= clave %>" accept="image/jpeg,image/png,image/webp" data-foto-archivo>
      </label>
      <button type="button" class="ce__link" data-foto-deshacer hidden>Deshacer</button>
      <% if (original && original !== valor) { %>
        <button type="button" class="ce__link" data-foto-original>Usar la original</button>
      <% } %>
    </div>
    <input type="hidden" name="<%= nombre %>" value="<%= valor %>" data-foto-ruta data-original="<%= original || '' %>">
    <% if (def.ayuda) { %><p class="ce__ayuda"><%= def.ayuda %></p><% } %>
  </div>

<% } else if (def.tipo === "opciones") { %>
  <div class="ce <%= ancho %>">
    <span class="campo__label"><%= def.etiqueta %></span>
    <div class="ce-opciones" role="radiogroup" aria-label="<%= def.etiqueta %>">
      <% Object.entries(def.opciones).forEach(([v, texto]) => { %>
        <label class="ce-opcion">
          <input type="radio" name="<%= nombre %>" value="<%= v %>" <%= v === valor ? 'checked' : '' %>>
          <span><i class="ce-opcion__muestra ce-opcion__muestra--<%= v %>"></i><%= texto %></span>
        </label>
      <% }) %>
    </div>
  </div>

<% } else { %>
  <%
    const largo = def.tipo === "lineas" || def.tipo === "parrafo";
    const filas = def.tipo === "lineas" ? Math.max(2, Math.min(def.maxLineas || 4, String(valor).split("\n").length + 1)) : 3;
    const tieneOriginal = original !== undefined && original !== null;
  %>
  <div class="ce <%= ancho %> <%= error ? 'campo--error' : '' %>" data-texto>
    <div class="ce__cabeza">
      <label class="campo__label" for="<%= id %>"><%= def.etiqueta %></label>
      <% if (def.max && def.tipo !== "numero" && def.tipo !== "link") { %>
        <span class="ce__cuenta" data-cuenta><%= String(valor).length %>/<%= def.max %></span>
      <% } %>
    </div>
    <% if (largo) { %>
      <textarea class="campo__control" id="<%= id %>" name="<%= nombre %>" rows="<%= filas %>" maxlength="<%= def.max %>"
                <% if (tieneOriginal) { %>data-original="<%= original %>"<% } %>
                <%- error ? 'aria-invalid="true"' : '' %>><%= valor %></textarea>
    <% } else { %>
      <input class="campo__control" id="<%= id %>" name="<%= nombre %>" value="<%= valor %>"
             type="<%= def.tipo === 'numero' ? 'number' : 'text' %>"
             <%- def.tipo === 'numero' ? `min="0" max="${def.max}" step="1" inputmode="numeric"` : `maxlength="${def.max}"` %>
             <%- def.tipo === 'link' ? 'inputmode="url" spellcheck="false" autocapitalize="off"' : '' %>
             placeholder="<%= def.placeholder || (def.tipo === 'link' ? '/catalogo o https://…' : '') %>"
             <% if (tieneOriginal) { %>data-original="<%= original %>"<% } %>
             <%- error ? 'aria-invalid="true"' : '' %>>
    <% } %>
    <div class="ce__pie">
      <% if (def.ayuda) { %><p class="ce__ayuda"><%= def.ayuda %></p><% } %>
      <% if (tieneOriginal) { %>
        <button type="button" class="ce__link" data-restaurar <%= String(original) === String(valor) ? 'hidden' : '' %>>Restaurar original</button>
      <% } %>
    </div>
    <% if (error) { %><p class="campo__error ce__error"><%= error %></p><% } %>
  </div>
<% } %>
