<%# Campanita de notificaciones (solo admins). La maneja /js/notificaciones.js %>
<div class="notif" id="notif">
  <button type="button" class="icono-btn notif__btn" id="notifBtn" aria-label="Notificaciones" aria-expanded="false" aria-controls="notifPanel">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15L6 16z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M10 20.5a2 2 0 004 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    <span class="notif__contador" id="notifContador" hidden>0</span>
  </button>

  <div class="notif__panel" id="notifPanel" role="dialog" aria-label="Notificaciones" hidden>
    <div class="notif__cabecera">
      <p class="notif__titulo">Notificaciones</p>
      <button type="button" class="notif__leer" id="notifLeerTodas">Marcar todas como leídas</button>
    </div>
    <ul class="notif__lista" id="notifLista">
      <li class="notif__vacio">Cargando…</li>
    </ul>
    <div class="notif__pie">
      <a href="/admin/pedidos" class="notif__link">Ver pedidos →</a>
      <button type="button" class="notif__opcion" id="notifSonido" aria-pressed="true">Sonido: sí</button>
      <button type="button" class="notif__opcion" id="notifNavegador" hidden>Avisos del navegador</button>
    </div>
  </div>
</div>
