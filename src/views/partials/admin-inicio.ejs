<%- include('head') %>

<%
  const iconos = {
    dashboard: '<path d="M4 13h6V4H4zM14 20h6v-9h-6zM4 20h6v-4H4zM14 7h6V4h-6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
    productos: '<path d="M4 8l8-4 8 4-8 4-8-4zM4 8v8l8 4 8-4V8M12 12v8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
    pedidos: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>',
    inicio: '<path d="M4 5h16v14H4zM4 15l4-4 4 4 3-3 5 5M15 9.5a1.5 1.5 0 100-.01" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>',
    tienda: '<path d="M4 10l1.5-5h13L20 10M4 10v10h16V10M4 10h16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  };
  const menuAdmin = [
    { id: "dashboard", texto: "Panel", href: "/admin" },
    { id: "productos", texto: "Productos", href: "/admin/productos", badge: totalProductos },
    { id: "pedidos", texto: "Pedidos", href: "/admin/pedidos", badge: pedidosPendientes, badgeFuerte: pedidosPendientes > 0 },
    // El editor del inicio es solo para el superadmin
    ...(esSuperAdmin(usuario) ? [{ id: "inicio", texto: "Página de inicio", href: "/admin/inicio" }] : []),
  ];
%>

<div class="admin">
  <!-- ═════════════ MENÚ LATERAL ═════════════ -->
  <aside class="admin-lateral" id="adminLateral" aria-label="Menú del panel">
    <div class="admin-lateral__marca">
      <img class="admin-lateral__logo" src="/img/marca/logo-claro.png" alt="Matilda boutique">
      <span class="admin-lateral__etiqueta"><%= esSuperAdmin(usuario) ? 'Super admin' : 'Admin' %></span>
    </div>

    <nav class="admin-nav">
      <% menuAdmin.forEach(item => { %>
        <a href="<%= item.href %>" class="admin-nav__link <%= seccion === item.id ? 'activo' : '' %>" <%- seccion === item.id ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><%- iconos[item.id] %></svg>
          <span><%= item.texto %></span>
          <% if (item.badge !== undefined) { %>
            <span class="admin-nav__badge <%= item.badgeFuerte ? 'admin-nav__badge--fuerte' : '' %>" data-badge="<%= item.id %>"><%= item.badge %></span>
          <% } %>
        </a>
      <% }) %>
      <a href="/" class="admin-nav__link admin-nav__link--tienda">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><%- iconos.tienda %></svg>
        <span>Ver tienda</span>
        <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="admin-usuario">
      <span class="admin-usuario__inicial"><%= usuario.nombre.charAt(0) %></span>
      <span class="admin-usuario__datos">
        <strong><%= usuario.nombre %> <%= usuario.apellido %></strong>
        <small><%= usuario.email %></small>
      </span>
      <form action="/logout" method="POST">
        <button type="submit" class="admin-usuario__salir" aria-label="Cerrar sesión" title="Cerrar sesión">
          <svg viewBox="0 0 24 24" width="18" height="18"><path d="M14 4h5v16h-5M10 8l-4 4 4 4M6 12h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </form>
    </div>
  </aside>

  <div class="admin-overlay" id="adminOverlay"></div>

  <div class="admin-cuerpo">
    <!-- Barra superior (celular / tablet) -->
    <header class="admin-barra">
      <button class="admin-barra__menu" id="adminMenuBtn" aria-label="Abrir menú" aria-controls="adminLateral" aria-expanded="false">
        <span></span>
      </button>
      <img class="admin-lateral__logo" src="/img/marca/logo-claro.png" alt="Matilda boutique">
      <div class="admin-barra__acciones">
        <%- include('notificaciones') %>
        <span class="admin-usuario__inicial"><%= usuario.nombre.charAt(0) %></span>
      </div>
    </header>

    <main class="admin-main">
